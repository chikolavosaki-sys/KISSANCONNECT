DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Comma-separated exact frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Neon example (use postgresql+psycopg:// and sslmode=require):
# DATABASE_URL=postgresql+psycopg://USER:PASS@HOST/neondb?sslmode=require
# Optional process settings for run.py.
HOST=0.0.0.0
PORT=8000
RELOAD=false
# In containers, prepare the schema on start. Both scripts are idempotent.
RUN_DB_INIT=true
# Set false only after importing your own approved reference data.
SEED_DEMO_DATA=true
